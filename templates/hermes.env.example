# Configure these through `hermes setup` and `hermes gateway setup`.
# This file documents the values expected in data/hermes/.env.

# Choose one model provider in the setup wizard.
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Telegram: create a bot with @BotFather and restrict it to numeric user IDs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
# TELEGRAM_HOME_CHANNEL=

# Email: always use a dedicated mailbox and an app password.
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_ALLOWED_USERS=
EMAIL_AUTHSERV_ID=
EMAIL_POLL_INTERVAL=15
# EMAIL_HOME_ADDRESS=

HERMES_TIMEZONE=Etc/UTC

